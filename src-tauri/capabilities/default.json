{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Overlay penceresi izinleri",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-minimize",
    "core:window:allow-is-minimized",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-set-content-protected",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-cursor-position",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:webview:allow-set-webview-zoom",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://tracker.gg/*"
        },
        {
          "url": "https://www.riotgames.com/tr/terms-of-service-TR"
        },
        {
          "url": "https://www.instagram.com/bneceleste"
        },
        {
          "url": "https://celeste-feed.celestimbenim.workers.dev/discord"
        },
        {
          "url": "https://celeste-feed.celestimbenim.workers.dev/discord/oneri"
        },
        {
          "url": "https://discord.gg/celestevlr"
        },
        {
          "url": "https://kick.com/bneceleste"
        },
        {
          "url": "https://www.youtube.com/@bneceleste"
        },
        {
          "url": "https://www.tiktok.com/@bneceleste"
        }
      ]
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "updater:default",
    "process:allow-restart"
  ]
}
